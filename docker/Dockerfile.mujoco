FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    libegl1 libgl1 libgles2 libglvnd0 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/mujoco_nist
COPY docker/mujoco_nist/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY docker/mujoco_nist .
ENV PYTHONUNBUFFERED=1 MUJOCO_GL=egl NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=graphics,utility,compute
ENTRYPOINT ["python", "server.py"]
